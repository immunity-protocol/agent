{
  "name": "@immunity-protocol/agent",
  "version": "0.1.0",
  "description": "Immunity template agent: the downloadable, SDK-based agent operators run to join the Immunity network (publisher / hunter / corroborator).",
  "license": "MIT",
  "type": "module",
  "private": true,
  "bin": {
    "immunity-agent": "./dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs');fs.cpSync('src/roles/threats.sample.json','dist/roles/threats.sample.json');fs.cpSync('src/data/threats','dist/data/threats',{recursive:true})\"",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "test": "node --test --import tsx test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@immunity-protocol/sdk": "file:../immunity-sdk",
    "ethers": "^6.14.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
